<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vogter.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Vogter.app/Contents/Helpers/vogterd</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Library/Logs/vogterd.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/vogterd.log</string>
</dict>
</plist>
